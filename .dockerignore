# Default-deny: no .git, .env, caches, saved runs, tests, or model weights.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!src/**/*.py
!data/tasks.json
!data/fixture/*.json
# Pre-rendered report only. Evaluation JSON stays out of the image:
# the deployed service must not parse an artifact to serve its landing page.
!results/report.html
