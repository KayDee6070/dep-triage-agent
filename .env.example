# Copy to .env and edit. Never commit .env — see .gitignore.
# Every DEP_TRIAGE_* setting in src/dep_triage/config.py must appear here;
# tests/test_env_example.py fails if the two drift apart.

# --- model ---
# "ollama" for local evaluation, "hosted" for the deployed demo.
DEP_TRIAGE_LLM_BACKEND=ollama
DEP_TRIAGE_LLM_NAME=qwen3:8b
DEP_TRIAGE_LLM_BASE_URL=http://localhost:11434/v1

# Leave empty for Ollama. Required only for the hosted demo backend.
DEP_TRIAGE_LLM_API_KEY=

# Keep at 0.0 for evaluation runs — reproducibility depends on it.
DEP_TRIAGE_LLM_TEMPERATURE=0.0
DEP_TRIAGE_LLM_SEED=42
DEP_TRIAGE_LLM_TIMEOUT_S=120

# "none" disables Qwen3's reasoning tokens, which otherwise dominate runtime.
# Leave empty for backends that reject the field.
DEP_TRIAGE_LLM_REASONING_EFFORT=none

# --- agent ---
DEP_TRIAGE_MAX_STEPS=8

# --- data ---
DEP_TRIAGE_FIXTURE_PATH=data/fixture

# --- service ---
DEP_TRIAGE_LOG_LEVEL=INFO
DEP_TRIAGE_ENABLE_METRICS=true

# Caps on the public demo so an open endpoint cannot be used as a free proxy.
DEP_TRIAGE_DEMO_DAILY_LIMIT=100
DEP_TRIAGE_DEMO_PER_MINUTE_LIMIT=5
